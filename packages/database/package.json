{
  "name": "@gdm/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:reset:development": "tsx src/reset-development.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed:supabase-auth": "tsx src/seed-supabase-auth.ts",
    "db:studio": "drizzle-kit studio",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/migration.integration.test.ts src/migration-compatibility.integration.test.ts src/recovery.integration.test.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@gdm/eslint-config": "workspace:*",
    "@gdm/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
