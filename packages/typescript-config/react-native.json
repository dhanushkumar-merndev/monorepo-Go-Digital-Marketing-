{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Go Digital React Native",
  "extends": "./base.json",
  "compilerOptions": {
    "allowJs": false,
    "jsx": "react-jsx",
    "lib": ["ES2024"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2022"
  }
}
