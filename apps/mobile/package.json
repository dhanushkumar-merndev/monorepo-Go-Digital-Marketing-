{
  "name": "@gdm/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "pnpm run build:android && pnpm run build:ios",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "dev": "expo start",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "native:generate:android": "expo prebuild --platform android --no-install",
    "native:generate:ios": "expo prebuild --platform ios --no-install",
    "start": "expo start",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@gdm/config": "workspace:*",
    "@gdm/contracts": "workspace:*",
    "@gdm/design-tokens": "workspace:*",
    "@supabase/supabase-js": "2.95.1",
    "@tanstack/react-query": "5.101.4",
    "expo": "57.0.11",
    "expo-build-properties": "57.0.9",
    "expo-constants": "57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-linking": "57.0.5",
    "expo-location": "57.0.8",
    "expo-network": "57.0.1",
    "expo-notifications": "57.0.9",
    "expo-router": "57.0.11",
    "expo-secure-store": "57.0.1",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.2",
    "expo-task-manager": "57.0.8",
    "nativewind": "4.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "2.32.0",
    "react-native-nitro-google-signin": "1.3.0",
    "react-native-nitro-modules": "0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@gdm/eslint-config": "workspace:*",
    "@gdm/typescript-config": "workspace:*",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "babel-preset-expo": "57.0.5",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "jest-expo": "57.0.3",
    "react-test-renderer": "19.2.8",
    "tailwindcss": "3.4.19",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts",
      "<rootDir>/src/**/__tests__/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  }
}
