{
  "name": "@gdm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Go Digital Automobile CRM REST API and infrastructure foundation",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint src test --max-warnings=0",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:coverage": "tsx --test --experimental-test-coverage test/*.spec.ts test/*.e2e-spec.ts",
    "test:integration": "tsx --test test/app.e2e-spec.ts",
    "test:unit": "tsx --test test/zod-validation.pipe.spec.ts",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1100.0",
    "@aws-sdk/s3-request-presigner": "3.1100.0",
    "@gdm/config": "workspace:*",
    "@gdm/contracts": "workspace:*",
    "@gdm/database": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@sentry/node": "10.69.0",
    "bullmq": "6.0.2",
    "ioredis": "6.0.0",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@gdm/eslint-config": "workspace:*",
    "@gdm/typescript-config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0 <27",
    "pnpm": ">=11.18.0 <12"
  }
}
