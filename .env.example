# Copy this file to .env for local API/database commands. Never commit real secrets.

# =============================================================================
# PHASE 0 — FOUNDATION, INFRASTRUCTURE, AND PUBLIC API URLS
# =============================================================================
NODE_ENV=development
API_HOST=0.0.0.0
# Render supplies PORT automatically; API_PORT is the local/container override.
API_PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
# Comma-separated IP/CIDR ranges for reverse proxies allowed to supply forwarded client IPs.
# Leave empty for direct/local connections; never use a catch-all value.
API_TRUSTED_PROXIES=

# Supabase runtime URL (use its session pooler where Render cannot use direct IPv6).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/go_digital_crm
# Drizzle migration/DDL URL. Database commands prefer this and fall back to DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/go_digital_crm
DATABASE_POOL_MAX=10

# Reserved backend-only Supabase integration inputs. Phase 0 uses DATABASE_URL instead.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Never expose the service-role key through NEXT_PUBLIC_* or EXPO_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash uses rediss:// in hosted environments. Local Redis uses redis://.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=2000

# disabled: enqueue only; embedded: process in API; standalone: separate worker process.
WORKER_MODE=disabled

# Hosted Tigris settings. Leave this complete set empty while using local/generic S3 below.
TIGRIS_ENDPOINT=
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=

# Generic S3 settings. MinIO is local; these also support Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=go-digital-crm-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Optional error reporter DSN. Empty means the no-op adapter is used.
SENTRY_DSN=

# Public client configuration. Do not add provider credentials here.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/v1

# =============================================================================
# PHASE 1 — EMAIL/PASSWORD AUTHENTICATION, SESSIONS, AND TENANCY
# =============================================================================
# API-only authentication secrets. Replace these development values in every hosted environment.
# Use independent random values of at least 32 characters; never expose them to web/mobile builds.
AUTH_ACCESS_TOKEN_SECRET=local-development-access-token-secret-change-me
AUTH_PASSWORD_PEPPER=local-development-password-pepper-change-me
AUTH_REFRESH_TOKEN_PEPPER=local-development-refresh-token-pepper-change-me
AUTH_ISSUER=go-digital-automobile-crm
AUTH_AUDIENCE=go-digital-automobile-crm-clients
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_SUPPORT_ELEVATION_TTL_SECONDS=900
AUTH_REFRESH_COOKIE_NAME=gdm_refresh
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_SECURE=false
# Development seed only; ignored by normal runtime and rejected when NODE_ENV=production.
# Seed password hashing uses the AUTH_PASSWORD_PEPPER value above.
SEED_DEVELOPMENT_PASSWORD=GoDigital-Dev-Only-2026!

# =============================================================================
# PHASE 1 GOOGLE AUTH AMENDMENT
# =============================================================================
# The API verifies every Google ID token against the web/server client ID audience.
# Native apps request an ID token for this audience; their platform IDs only register the app.
GOOGLE_AUTH_WEB_CLIENT_ID=
# Server-side challenge lifetime for Google ID-token nonce validation.
GOOGLE_AUTH_CHALLENGE_TTL_SECONDS=300
# Browser-safe GIS client ID; it must equal GOOGLE_AUTH_WEB_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Native requests the same web/server audience that the API verifies.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS app registration/reversed URL scheme only; the API never accepts it as an audience.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Provider secrets must never use a NEXT_PUBLIC_* or EXPO_PUBLIC_* variable.
# Phase 3 lead phone lookup HMAC. Backend-only; never expose to web or mobile.
LEAD_PHONE_LOOKUP_PEPPER=local-development-lead-phone-pepper-change-me
LEAD_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# PHASE 4 â€” PROVIDER-NEUTRAL TELEPHONY
# =============================================================================
# Backend-only HMAC secret for the local development telephony adapter. It is never sent to web/mobile.
# A production provider must use its own reviewed signature and encrypted tenant secret reference.
TELEPHONY_DEVELOPMENT_WEBHOOK_SECRET=local-development-telephony-webhook-secret-change-me
TELEPHONY_RECORDING_URL_TTL_SECONDS=300
TELEPHONY_MANUAL_RECORDING_MAX_BYTES=26214400
TELEPHONY_WEBHOOK_RAW_RETENTION_HOURS=168

# =============================================================================
# PHASE 5 — PROVIDER-NEUTRAL MESSAGING AND WHATSAPP CLOUD
# =============================================================================
# Backend-only HMAC secret for signed development messaging fixtures.
MESSAGING_DEVELOPMENT_WEBHOOK_SECRET=local-development-messaging-webhook-secret-change-me
# Optional in development; required before saving WhatsApp Cloud credentials. Generate 32 random
# bytes and encode them as base64. Never expose this value through NEXT_PUBLIC_* or EXPO_PUBLIC_*.
MESSAGING_CREDENTIAL_ENCRYPTION_KEY=
MESSAGING_CREDENTIAL_KEY_ID=messaging-v1
MESSAGING_MEDIA_MAX_BYTES=26214400
MESSAGING_MEDIA_RETENTION_DAYS=365
MESSAGING_MEDIA_URL_TTL_SECONDS=300
MESSAGING_OUTBOUND_MAX_ATTEMPTS=5
MESSAGING_SERVICE_WINDOW_HOURS=24
MESSAGING_WEBHOOK_RAW_RETENTION_HOURS=168

# =============================================================================
# PHASE 6 — TEST-RIDE OPERATIONS AND ACTIVE LOCATION
# =============================================================================
# Backend-only HMAC pepper for optional per-ride OTP verification. Use an independent 32+ character
# secret in staging and production; never expose it through NEXT_PUBLIC_* or EXPO_PUBLIC_*.
TEST_RIDE_OTP_PEPPER=local-test-ride-otp-pepper-change-me
# Server-enforced active tracking timeout, location retention and manager stale-label threshold.
TEST_RIDE_ACTIVE_TIMEOUT_MINUTES=180
TEST_RIDE_LOCATION_RETENTION_DAYS=30
TEST_RIDE_LOCATION_STALE_SECONDS=120

# =============================================================================
# PHASE 7 — VEHICLE INVENTORY AND ALLOCATION
# =============================================================================
# No Phase 7 provider credential or browser/mobile environment value is required. Inventory
# concurrency, reservation expiry, immutable transfer history and test-ride linkage are enforced in
# PostgreSQL/NestJS. Do not add payment credentials or billing authority to the inventory module.

# =============================================================================
# PHASE 8 — COMMERCIAL BOOKING, BILLING AND PRIVATE DOCUMENTS
# =============================================================================
# Phase 8 reuses the private S3/Tigris configuration above and has no payment-provider credential.
# The built-in document scanner adapter is deliberately fail-closed: uploads remain
# PENDING_EXTERNAL_SCAN and cannot be approved until a reviewed malware-scanner adapter is bound.
# Do not expose object keys, storage credentials, document binaries or tenant thresholds to clients.

# =============================================================================
# PHASE 9 - DELIVERY OPERATIONS, PROOF AND ACTIVE LOCATION
# =============================================================================
# Backend-only HMAC pepper for optional delivery OTP proof. Use an independent 32+ character secret
# in staging/production and never expose it through NEXT_PUBLIC_* or EXPO_PUBLIC_*.
DELIVERY_OTP_PEPPER=local-delivery-otp-pepper-change-me
# Delivery tracking timeout/retention/stale thresholds are tenant settings stored in PostgreSQL.
# The built-in OTP sender and photo/signature scanner fail closed until reviewed adapters are bound.

# =============================================================================
# PHASE 10 - REGISTRATION, RC AND CUSTOMER VEHICLES
# =============================================================================
# Phase 10 adds no public or provider credential. Registration SLA hours are tenant settings in
# PostgreSQL. Private RC copies reuse the S3/Tigris variables above; the built-in RC malware scanner
# fails closed, so a document cannot be Verified or shared until a reviewed adapter reports CLEAN.
