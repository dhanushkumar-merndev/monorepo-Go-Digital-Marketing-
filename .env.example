# Copy this file to .env for local API/database commands. Never commit real secrets.
NODE_ENV=development
API_HOST=0.0.0.0
# Render supplies PORT automatically; API_PORT is the local/container override.
API_PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
# Comma-separated IP/CIDR ranges for reverse proxies allowed to supply forwarded client IPs.
# Leave empty for direct/local connections; never use a catch-all value.
API_TRUSTED_PROXIES=

# API-only authentication secrets. Replace these development values in every hosted environment.
# Use independent random values of at least 32 characters; never expose them to web/mobile builds.
AUTH_ACCESS_TOKEN_SECRET=local-development-access-token-secret-change-me
AUTH_PASSWORD_PEPPER=local-development-password-pepper-change-me
AUTH_REFRESH_TOKEN_PEPPER=local-development-refresh-token-pepper-change-me
AUTH_ISSUER=go-digital-automobile-crm
AUTH_AUDIENCE=go-digital-automobile-crm-clients
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_SUPPORT_ELEVATION_TTL_SECONDS=900
AUTH_REFRESH_COOKIE_NAME=gdm_refresh
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_SECURE=false
# Development seed only; ignored by normal runtime and rejected when NODE_ENV=production.
# Seed password hashing uses the AUTH_PASSWORD_PEPPER value above.
SEED_DEVELOPMENT_PASSWORD=GoDigital-Dev-Only-2026!

# Supabase runtime URL (use its session pooler where Render cannot use direct IPv6).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/go_digital_crm
# Drizzle migration/DDL URL. Database commands prefer this and fall back to DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/go_digital_crm
DATABASE_POOL_MAX=10

# Reserved backend-only Supabase integration inputs. Phase 0 uses DATABASE_URL instead.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Never expose the service-role key through NEXT_PUBLIC_* or EXPO_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash uses rediss:// in hosted environments. Local Redis uses redis://.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=2000

# disabled: enqueue only; embedded: process in API; standalone: separate worker process.
WORKER_MODE=disabled

# Hosted Tigris settings. Leave this complete set empty while using local/generic S3 below.
TIGRIS_ENDPOINT=
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=

# Generic S3 settings. MinIO is local; these also support Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=go-digital-crm-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Optional error reporter DSN. Empty means the no-op adapter is used.
SENTRY_DSN=

# Public client configuration. Do not add provider credentials here.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
